#!/usr/bin/env python3
"""Claude 데스크탑 앱 세션과 터미널 CLI 세션을 서로 옮겨 이어가게 해 준다.

앱 세션 → CLI:
  app-sessions                 앱 세션 전체 목록 (최근 활동 순)
  app-sessions 검색어          제목·폴더·ID 에 검색어가 들어간 세션만
  app-sessions -r 검색어       찾은 세션을 해당 폴더에서 `claude --resume` 으로 이어가기
                               (여러 개면 번호를 골라서)
  app-sessions -a ...          보관(archive)된 세션만 보기

CLI 세션 → 앱:
  app-sessions --cli [검색어]  아직 앱에 없는 CLI 세션 목록
  app-sessions -o 검색어       찾은 CLI 세션을 데스크탑 앱에서 열기 (여러 개면 번호를 골라서)
                               CLI 의 /desktop 과 같은 링크(claude://resume?session=ID)를 연다

공통:
  --json                       기계가 읽을 JSON 으로 출력
"""
import glob
import json
import os
import subprocess
import sys
from datetime import datetime

APP_DIR = os.path.expanduser("~/Library/Application Support/Claude/claude-code-sessions")
CLI_DIR = os.path.expanduser("~/.claude/projects")
RUNNING_DIR = os.path.expanduser("~/.claude/sessions")  # 실행 중인 세션: <pid>.json


def running_ids():
    """지금 프로세스가 살아 있는 세션 ID 집합 (앱·CLI 모두)."""
    ids = set()
    for path in glob.glob(os.path.join(RUNNING_DIR, "*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                d = json.load(f)
            os.kill(int(d["pid"]), 0)
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            continue
        if d.get("sessionId"):
            ids.add(d["sessionId"])
    return ids


def current_account():
    """CLI 가 로그인한 계정 ID. 앱 세션 폴더 이름(<계정 ID>/<조직 ID>/)과 대조한다."""
    try:
        with open(os.path.expanduser("~/.claude.json"), encoding="utf-8") as f:
            return (json.load(f).get("oauthAccount") or {}).get("accountUuid")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None


def load_sessions():
    rows = []
    running = running_ids()
    me = current_account()
    for path in glob.glob(os.path.join(APP_DIR, "*", "*", "local_*.json")):
        account = os.path.basename(os.path.dirname(os.path.dirname(path)))
        try:
            with open(path, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        cli_id = d.get("cliSessionId")
        if not cli_id:
            continue
        rows.append({
            "app_id": d.get("sessionId"),
            "title": d.get("title") or "(제목 없음)",
            "cwd": d.get("cwd") or d.get("originCwd") or "",
            "cli_id": cli_id,
            "archived": bool(d.get("isArchived")),
            "running": cli_id in running,
            # 앱 사이드바는 로그인한 계정 폴더의 세션만 보여 준다 (추정). 다른 계정 세션도 CLI 로는 이어갈 수 있다
            "account": account,
            "other_account": bool(me) and account != me,
            "last": (d.get("lastActivityAt") or d.get("createdAt") or 0) / 1000,
            # CLI 기록 파일이 남아 있어야 이어갈 수 있다 (cleanupPeriodDays 에 따라 자동 삭제될 수 있음)
            "has_log": bool(glob.glob(os.path.join(CLI_DIR, "*", cli_id + ".jsonl"))),
        })
    rows.sort(key=lambda r: r["last"], reverse=True)
    return rows


def _user_text(r):
    """사람이 직접 입력한 첫 메시지인지 보고, 맞으면 그 글을 돌려준다."""
    if r.get("type") != "user" or r.get("isMeta") or r.get("isSidechain"):
        return None
    msg = r.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, list):
        content = " ".join(c.get("text", "") for c in content
                           if isinstance(c, dict) and c.get("type") == "text")
    if not isinstance(content, str):
        return None
    text = " ".join(content.split())
    if not text or text.startswith("<"):  # 슬래시 명령·시스템 삽입 메시지
        return None
    return text


def _last_timestamp(path):
    """큰 파일도 빠르게: 끝부분만 읽어 마지막 timestamp 를 찾는다."""
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        f.seek(max(0, size - 262144))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            ts = json.loads(line).get("timestamp")
        except (json.JSONDecodeError, AttributeError):
            continue
        if ts:
            try:
                return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
            except ValueError:
                pass
    return os.path.getmtime(path)


def load_cli_sessions():
    """아직 앱에 없는, 터미널 CLI 에서 만든 세션."""
    in_app = {r["cli_id"] for r in load_sessions()}
    running = running_ids()
    rows = []
    for path in glob.glob(os.path.join(CLI_DIR, "*", "*.jsonl")):
        cli_id = os.path.basename(path)[:-6]
        if cli_id in in_app:
            continue
        entrypoint = cwd = first = title = custom = None
        with open(path, encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f):
                # 앞부분은 모두 읽고, 뒤는 제목 레코드만 골라 읽는다 (수십 MB 파일 대비)
                if n >= 300 and '"custom-title"' not in line and '"ai-title"' not in line:
                    continue
                try:
                    r = json.loads(line)
                except json.JSONDecodeError:
                    continue
                entrypoint = entrypoint or r.get("entrypoint")
                cwd = cwd or r.get("cwd")
                if first is None:
                    first = _user_text(r)
                if r.get("type") == "custom-title" and r.get("customTitle"):
                    custom = r["customTitle"]  # 사용자가 /rename 으로 붙인 제목이 우선
                elif r.get("type") == "ai-title" and r.get("aiTitle"):
                    title = r["aiTitle"]
        title = custom or title
        if entrypoint != "cli" or not (first or title):
            continue  # 앱·SDK 가 만든 세션, 대화가 없는 빈 세션은 뺀다
        rows.append({
            "cli_id": cli_id,
            "title": title or first[:60],
            "first_prompt": (first or "")[:120],
            "cwd": cwd or "",
            "running": cli_id in running,
            "last": _last_timestamp(path),
        })
    rows.sort(key=lambda r: r["last"], reverse=True)
    return rows


def show(rows, numbered=False):
    home = os.path.expanduser("~")
    for i, r in enumerate(rows, 1):
        mark = "[실행 중] " if r.get("running") else ""
        if r.get("archived"):
            mark += "[보관] "
        if r.get("has_log") is False:
            mark += "[기록 없음] "
        if r.get("other_account"):
            mark += f"[다른 계정 {r['account'][:8]}] "
        when = datetime.fromtimestamp(r["last"]).strftime("%m-%d %H:%M") if r["last"] else "-"
        head = f"{i:>2}. " if numbered else ""
        print(f"{head}{when}  {mark}{r['title']}")
        print(f"{' ' * len(head)}       {r['cwd'].replace(home, '~', 1)}")
        print(f"{' ' * len(head)}       {r['cli_id']}")


def confirm(question):
    try:
        return input(question).strip().lower() in ("y", "yes", "예", "ㅇ")
    except (EOFError, KeyboardInterrupt):
        return False


def resume(r):
    if not r["has_log"]:
        sys.exit(f"CLI 기록 파일이 없어 이어갈 수 없습니다: {r['cli_id']}")
    if not os.path.isdir(r["cwd"]):
        sys.exit(f"작업 폴더가 없습니다: {r['cwd']}")
    if r["running"] and not confirm(
            "이 세션은 지금 앱에서 실행 중입니다. 동시에 쓰면 기록이 엉킬 수 있습니다. 계속할까요? (y/N) "):
        return
    print(f"\n'{r['title']}' 세션을 이어갑니다.")
    print("앱에서 같은 세션이 열려 있으면 먼저 닫아 주세요 (동시에 쓰면 기록이 엉킬 수 있음).\n")
    os.chdir(r["cwd"])
    os.execvp("claude", ["claude", "--resume", r["cli_id"]])


def open_in_app(r):
    if r["running"]:
        sys.exit(f"'{r['title']}' 세션이 터미널에서 실행 중입니다. 먼저 /exit 로 끝낸 뒤 다시 실행하세요.\n"
                 "(실행 중인 세션은 그 터미널에서 /desktop 을 입력해도 앱으로 넘어갑니다.)")
    url = f"claude://resume?session={r['cli_id']}"
    if subprocess.run(["open", url]).returncode != 0:
        sys.exit(f"앱을 열지 못했습니다: {url}")
    print(f"'{r['title']}' 세션을 데스크탑 앱에서 열었습니다. 사이드바에서 확인하세요.")


def pick_and_run(rows, action, prompt):
    if len(rows) == 1:
        action(rows[0])
        return
    show(rows, numbered=True)
    try:
        pick = input(f"\n{prompt} (취소: Enter): ").strip()
    except (EOFError, KeyboardInterrupt):
        return
    if pick.isdigit() and 1 <= int(pick) <= len(rows):
        action(rows[int(pick) - 1])


def main(argv):
    do_resume = do_open = cli_mode = archived_only = as_json = False
    words = []
    for a in argv:
        if a in ("-r", "--resume"):
            do_resume = True
        elif a in ("-o", "--open"):
            do_open = cli_mode = True
        elif a == "--cli":
            cli_mode = True
        elif a in ("-a", "--archived"):
            archived_only = True
        elif a == "--json":
            as_json = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return
        else:
            words.append(a)

    if cli_mode and (do_resume or archived_only):
        sys.exit("--cli/-o 는 -r, -a 와 함께 쓸 수 없습니다.")

    rows = load_cli_sessions() if cli_mode else load_sessions()
    if archived_only:
        rows = [r for r in rows if r["archived"]]
    query = " ".join(words).lower()
    if query:
        rows = [r for r in rows if query in r["title"].lower() or query in r["cwd"].lower()
                or query in r["cli_id"] or query in r.get("first_prompt", "").lower()]

    if as_json:
        for r in rows:
            r["last"] = datetime.fromtimestamp(r["last"]).isoformat(timespec="minutes") if r["last"] else None
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return

    if not rows:
        if cli_mode:
            sys.exit("일치하는 CLI 세션이 없습니다. 이미 앱에 있는 세션이면 `app-sessions 검색어` 로 찾아보세요.")
        sys.exit("일치하는 앱 세션이 없습니다.")

    if do_open:
        pick_and_run(rows, open_in_app, "앱에서 열 번호")
    elif do_resume:
        pick_and_run(rows, resume, "이어갈 번호")
    else:
        show(rows)


if __name__ == "__main__":
    main(sys.argv[1:])
